manifesto {
  mission = "Clair is trendvidia's internal clarity/readability analysis service. It owns static legibility scoring, plain-language grading, and readability-gate enforcement for content published through the trendvidia platform."
  mission_drift_gate = true
  blocked_module_globs = [
    # Competing readability/NLP libraries that would duplicate Clair's own scoring logic
    "github.com/jdkato/prose",
    "github.com/neurosnap/sentences",
    "github.com/abadojack/whatlanggo",
    # Heavy ML frameworks; Clair should stay lightweight and call out to inference services
    "github.com/gorgonia/gorgonia",
    "github.com/owulveryck/onnx-go",
  ]
  max_perf_regression_percent = 10
  # Readability scoring is on hot paths; 10 % regression threshold + significance
  # gate together avoid false positives from benchmark noise in CI.
  perf_significance_alpha = 0.05
}

domains = [
  {
    name = "scorer"
    # Core scoring algorithms: Flesch-Kincaid, Gunning Fog, etc.
    path_globs = ["internal/scorer/**", "pkg/scorer/**"]
    min_coverage = 85
    max_cyclomatic_complexity = 8
    approval_threshold = 150
    criticality_multiplier = 2.5
    # Scoring logic is the product; hold it to the highest bar.
  }
  {
    name = "api"
    path_globs = ["internal/api/**", "cmd/**"]
    min_coverage = 75
    max_cyclomatic_complexity = 10
    approval_threshold = 100
    criticality_multiplier = 1.5
  }
  {
    name = "gate"
    # Readability-gate enforcement: the decision engine that
    # accepts/rejects content based on configured thresholds.
    path_globs = ["internal/gate/**", "pkg/gate/**"]
    min_coverage = 90
    max_cyclomatic_complexity = 7
    approval_threshold = 200
    criticality_multiplier = 3.0
    restricted = true
    supermajority_ratio = 0.75
    # Gate logic has direct production impact on what content
    # passes through the platform; changes must be deliberate.
  }
  {
    name = "config"
    path_globs = ["config/**", "internal/config/**"]
    min_coverage = 70
    max_cyclomatic_complexity = 6
    approval_threshold = 100
    criticality_multiplier = 1.0
  }
  {
    name = "migrations"
    path_globs = ["migrations/**", "db/**"]
    min_coverage = 0
    restricted = true
    supermajority_ratio = 1.0
    criticality_multiplier = 2.0
    # Schema changes are irreversible; unanimous team sign-off required.
  }
  {
    name = "infra"
    path_globs = ["deploy/**", "scripts/**", "Makefile", "*.yaml", "*.yml", "Dockerfile*", ".github/**"]
    min_coverage = 0
    restricted = true
    supermajority_ratio = 0.75
    criticality_multiplier = 2.0
  }
  {
    name = "docs"
    path_globs = ["docs/**", "**/*.md", "**/*.txt"]
    min_coverage = 0
    criticality_multiplier = 0.5
  }
  {
    # Safety net: any file not matched above still gets evaluated.
    name = "other"
    path_globs = ["**"]
    min_coverage = 60
    max_cyclomatic_complexity = 12
    approval_threshold = 50
    criticality_multiplier = 1.0
  }
]

escrow {
  # Private internal repo — no external contributor funnel needed.
  sandbox_issue_count = 0
  sandbox_labels = []
  sandbox_templates = []
}

decay {
  # 90-day half-life suits an internal team that rotates tasks
  # faster than open-source projects do.
  half_life = 2160h
  base_points = 100
}

immune_system {
  # Internal service: GPL/AGPL are acceptable because we don't
  # distribute binaries externally.
  allowed_licenses = [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "MPL-2.0",
    "GPL-3.0",
    "AGPL-3.0",
  ]
  require_pinned_dependencies = true
  anomaly_quarantine {
    # Hold any PR where ≥ 70 % of the diff is non-code;
    # a docs-heavy PR shouldn't slip gate or scorer changes.
    documentation_concentration = 0.70
    sensitive_path_globs = [
      "internal/gate/**",
      "internal/auth/**",
      "config/**",
      "migrations/**",
      "deploy/**",
      ".steward/**",
    ]
    # 24-hour timelock on sensitive paths; forces an async
    # review window even for out-of-hours pushes.
    timelock = 24h
  }
}

amendments {
  supermajority_ratio = 0.75
  # Private team likely has 3–6 engineers; top-5 covers the
  # realistic quorum while excluding occasional contractors.
  top_n_holders = 5
  # 72-hour voting window keeps governance nimble for an
  # internal team without sacrificing deliberation.
  voting_period = 72h
  amendment_path_globs = [
    ".steward/governance.pxf",
    "CODEOWNERS",
  ]
}

slashing {
  # Internal service that's on-call owned: slashing creates
  # the right incentive for careful gate and scorer changes.
  enabled = true
  base_points = 50
  # Penalty doubles every ~60 days; bugs that surface late
  # (slow regressions in scoring accuracy) carry extra weight.
  growth_half_life = 1440h
  max_multiplier = 5.0
}

founders = [
  {
    # Replace with actual GitHub handles of the founding team.
    # Seed values reflect domain specialization; adjust before
    # committing to avoid distorted governance from day one.
    handle = "founder-1"
    reputation_seed = {
      "scorer": 1200
      "gate": 1200
      "api": 800
      "config": 600
      "migrations": 600
      "infra": 400
      "docs": 300
      "other": 300
    }
  }
  {
    handle = "founder-2"
    reputation_seed = {
      "scorer": 800
      "gate": 800
      "api": 1200
      "config": 600
      "migrations": 400
      "infra": 600
      "docs": 300
      "other": 300
    }
  }
]

alternatives {
  enabled = true
  groups = [
    {
      name = "http-router"
      modules = [
        "github.com/gorilla/mux",
        "github.com/go-chi/chi/v5",
        "github.com/labstack/echo/v4",
        "github.com/gin-gonic/gin",
      ]
    }
    {
      name = "logger"
      modules = [
        "github.com/sirupsen/logrus",
        "go.uber.org/zap",
        "github.com/rs/zerolog",
      ]
    }
    {
      name = "config-loader"
      modules = [
        "github.com/spf13/viper",
        "github.com/kelseyhightower/envconfig",
        "github.com/caarlos0/env/v6",
        "github.com/ilyakaznacheev/cleanenv",
      ]
    }
    {
      name = "readability-external"
      # Explicit list of external readability packages that
      # must not coexist with Clair's own scorer.
      modules = [
        "github.com/jdkato/prose",
        "github.com/nicholasgasior/readability",
        "github.com/bbalet/stopwords",
      ]
    }
  ]
  behavioral {
    jaccard_threshold = 0.35
    max_pairs = 20
    extra_stopwords = ["Score", "Grade", "Level", "Text", "Word", "Sentence"]
  }
}

sarif {
  # Enabled in anticipation of CI-side linting (staticcheck,
  # golangci-lint with SARIF output). The gate pipeline is
  # ready when CI emits .sarif artifacts.
  enabled = true
  artifact_glob = "*.sarif"
}

precedent {
  # Low issue volume for a private repo; jaccard is sufficient.
  backend = "jaccard"
  threshold = 0.45
  candidate_limit = 50
}

triage {
  backend = "deterministic"
  # gate domain has criticality_multiplier = 3.0, scorer = 2.5;
  # use tighter thresholds so gate-touching issues always surface
  # as high priority rather than drowning in medium.
  high_priority_min = 2.0
  medium_priority_min = 1.0
}

caliper {
  # Go service with readability-gate enforcement; nil-deref and
  # injection rules are most relevant. Enabling caliper here
  # ensures gate correctness gets inter-procedural scrutiny.
  enabled = true
  rules = [
    "nil_deref",
    "sql_injection",
    "command_injection",
    "path_traversal",
    "race_condition",
  ]
}